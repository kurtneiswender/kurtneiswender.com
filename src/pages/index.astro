---
import BaseLayout from '../layouts/BaseLayout.astro';
import GardenCard from '../components/GardenCard.astro';
import ToolCard from '../components/ToolCard.astro';
import { getCollection } from 'astro:content';

const gardenArticles = await getCollection('garden');
const latestArticles = gardenArticles
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  .slice(0, 4);

const tools = [
  {
    title: 'HVAC Calculator',
    description: 'Energy modeling and HVAC load calculations for architects and engineers.',
    href: '/tools/hvac-calculator',
    status: 'live' as const,
    icon: '🌡️',
  },
  {
    title: 'EchoTrace',
    description: 'Acoustic simulation and room acoustics visualization tool.',
    href: '/tools/echotrace',
    status: 'live' as const,
    icon: '🔊',
  },
  {
    title: 'Timber Designer',
    description: 'Parametric mass timber building designer with 3D visualization.',
    href: '/tools/timber-designer',
    status: 'beta' as const,
    icon: '🪵',
  },
  {
    title: 'Proposal Writer',
    description: 'AI-assisted lead qualification and proposal generation for architecture firms.',
    href: '/tools/proposal-writer',
    status: 'beta' as const,
    icon: '📋',
  },
];
---

<BaseLayout title="Home">

  <!-- ── Hero (full viewport, dark) ── -->
  <section
    class="bg-ink border-b border-rule-dark flex flex-col"
    style="min-height: calc(100dvh - 60px);"
  >
    <div class="max-w-7xl mx-auto px-8 pt-20 pb-0 w-full flex-1 flex flex-col">

      <!-- Top bar -->
      <div class="flex items-baseline justify-between mb-10 animate-fade-up">
        <span class="font-mono text-[0.75rem] tracking-[0.18em] uppercase text-accent">
          Architect &middot; Educator &middot; Toolmaker
        </span>
        <span class="font-mono text-[0.625rem] tracking-[0.1em] text-[#888] hidden sm:block">
          43.0125&deg;&thinsp;N, 83.6875&deg;&thinsp;W &thinsp;/&thinsp; Flint, MI
        </span>
      </div>

      <!-- Headline -->
      <h1
        class="font-heading font-extrabold uppercase leading-[0.93] tracking-[-0.015em] text-text-inv mb-14 animate-fade-up"
        style="font-size: clamp(4.5rem, 7vw + 2rem, 10rem); animation-delay: 0.05s;"
      >
        <span style="-webkit-text-stroke: 1.5px var(--color-text-inv); color: transparent;">Building</span><br>
        <span style="color: var(--color-accent);">Instruments</span><br>
        for Practice
      </h1>

      <!-- Bio + index grid -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-16 pt-10 border-t border-rule-dark animate-fade-up"
        style="animation-delay: 0.15s;"
      >
        <!-- Bio -->
        <p class="text-[1.125rem] font-normal leading-[1.75] text-text-inv">
          I&rsquo;m Kurt Neiswender, AIA&mdash;a registered architect, LEED AP, and
          <a href="https://ltu.edu/faculty/neiswender-aia-kurt/" target="_blank" rel="noopener"
             class="border-b border-[rgba(255,255,255,0.3)] hover:border-accent hover:text-accent transition-colors">
            educator at Lawrence Tech
          </a>,
          learning in public through writing, teaching, and making tools for the profession.
          I run <a href="https://www.urbancolab.design" target="_blank" rel="noopener"
                   class="border-b border-[rgba(255,255,255,0.3)] hover:border-accent hover:text-accent transition-colors">
            Urban Colab Architecture
          </a>
          in Flint, Michigan and co-host the
          <a href="https://www.coffeesketchpodcast.com" target="_blank" rel="noopener"
             class="border-b border-[rgba(255,255,255,0.3)] hover:border-accent hover:text-accent transition-colors">
            Coffee Sketch Podcast
          </a>.
        </p>

        <!-- Index grid -->
        <div class="grid grid-cols-2 gap-0">
          {[
            { num: '01', href: '/garden',   label: 'Garden',   meta: `${gardenArticles.length} articles` },
            { num: '02', href: '/teaching', label: 'Teaching', meta: 'LTU · EDRA'                        },
            { num: '03', href: '/tools',    label: 'Tools',    meta: '5 tools'                            },
            { num: '04', href: '/media',    label: 'Media',    meta: 'Coffee Sketch'                      },
          ].map((item) => (
            <a
              href={item.href}
              class="group p-6 border border-rule-dark -mr-px -mb-px overflow-hidden transition-colors duration-200 hover:bg-accent"
            >
              <p class="font-mono text-[0.5625rem] tracking-[0.1em] text-[#888] mb-3 transition-opacity duration-200 group-hover:opacity-0">
                {item.num}
              </p>
              <p class="font-heading text-[clamp(1.375rem,2vw+0.25rem,2rem)] font-extrabold uppercase leading-none text-text-inv mb-2 transition-colors duration-200 group-hover:text-ink">
                {item.label}
              </p>
              <p class="font-mono text-[0.5rem] tracking-[0.08em] text-[#888] transition-opacity duration-200 group-hover:opacity-0">
                {item.meta}
              </p>
            </a>
          ))}
        </div>
      </div>

      <!-- Spacer -->
      <div class="flex-1"></div>

      <!-- Scroll indicator -->
      <div
        class="flex flex-col items-center pb-8 pt-6"
        style="color: var(--color-accent); animation: bounce 1.8s ease-in-out infinite;"
        aria-hidden="true"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 7 10 13 16 7" />
        </svg>
      </div>

    </div>
  </section>

  <!-- ── Tools ── -->
  <section class="bg-bg border-b border-rule">
    <div class="max-w-7xl mx-auto px-8 py-14 md:py-16">
      <div class="flex items-end justify-between mb-8 pb-6 border-b border-rule">
        <div>
          <p class="kicker">Practice</p>
          <h2>Tools for Architects</h2>
        </div>
        <a href="/tools" class="font-mono text-[0.6875rem] tracking-[0.12em] uppercase text-text-secondary border-b border-rule pb-px hover:text-text hover:border-text transition-colors">
          All tools &thinsp;&rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-0">
        {tools.map((tool) => (
          <ToolCard {...tool} />
        ))}
      </div>
    </div>
  </section>

  <!-- ── Garden ── -->
  <section class="bg-bg">
    <div class="max-w-7xl mx-auto px-8 py-14 md:py-16">
      <div class="flex items-end justify-between mb-8 pb-6 border-b border-rule">
        <div>
          <p class="kicker">Learning in Public</p>
          <h2>From the Garden</h2>
        </div>
        <a href="/garden" class="font-mono text-[0.6875rem] tracking-[0.12em] uppercase text-text-secondary border-b border-rule pb-px hover:text-text hover:border-text transition-colors">
          All articles &thinsp;&rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-0">
        {latestArticles.map((article) => (
          <GardenCard
            title={article.data.title}
            description={article.data.description}
            maturity={article.data.maturity}
            slug={article.id}
            updated={article.data.updated}
          />
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(10px); }
  }
</style>
