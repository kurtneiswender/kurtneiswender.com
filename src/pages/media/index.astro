---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Media" description="Coffee Sketch Podcast, speaking engagements, and publications by Kurt Neiswender.">

  <!-- Dark header -->
  <header class="bg-ink border-b border-rule-dark animate-fade-up">
    <div class="max-w-7xl mx-auto px-8 py-16 md:py-20">
      <p class="kicker">Media</p>
      <h1 class="text-text-inv mb-5" style="font-size: clamp(2.5rem, 4vw + 1rem, 5rem);">Media</h1>
      <p class="text-[1rem] leading-relaxed text-[#888] max-w-xl">
        Conversations about architecture, education, and practice&mdash;through
        podcast, speaking, and writing.
      </p>
    </div>
  </header>

  <!-- Light content -->
  <section class="bg-bg">
    <div class="max-w-7xl mx-auto px-8 py-12 md:py-14">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-10">

        <!-- Podcast -->
        <a href="/media/podcast"
           class="group block p-8 md:p-10 border border-rule bg-bg relative overflow-hidden transition-colors hover:bg-surface">
          <div class="absolute top-0 left-0 right-0 h-[3px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left" aria-hidden="true"></div>
          <p class="kicker">Podcast</p>
          <h2 class="font-heading text-[1.75rem] font-bold uppercase mb-4">Coffee Sketch Podcast</h2>
          <p class="text-[0.875rem] text-text-secondary leading-relaxed mb-6">
            Conversations over coffee and sketching about architecture, practice,
            and the spaces between. 190+ episodes, listeners in 80+ countries.
            Co-hosted with Jamie Crawley, AIA.
          </p>
          <span class="font-mono text-[0.5625rem] tracking-[0.12em] uppercase text-text-secondary group-hover:text-text transition-colors">
            Listen &thinsp;&rarr;
          </span>
        </a>

        <!-- Speaking -->
        <a href="/media/speaking"
           class="group block p-8 md:p-10 border border-rule -ml-px bg-bg relative overflow-hidden transition-colors hover:bg-surface">
          <div class="absolute top-0 left-0 right-0 h-[3px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left" aria-hidden="true"></div>
          <p class="kicker">Speaking</p>
          <h2 class="font-heading text-[1.75rem] font-bold uppercase mb-4">Speaking</h2>
          <p class="text-[0.875rem] text-text-secondary leading-relaxed mb-6">
            Talks, panels, and presentations on architectural education,
            computational tools, and sustainable design&mdash;from AIA National
            Conference to local community forums.
          </p>
          <span class="font-mono text-[0.5625rem] tracking-[0.12em] uppercase text-text-secondary group-hover:text-text transition-colors">
            View talks &thinsp;&rarr;
          </span>
        </a>

      </div>

      <!-- External links -->
      <div class="flex flex-wrap gap-0">
        {[
          { href: 'https://www.coffeesketchpodcast.com',        label: 'coffeesketchpodcast.com' },
          { href: 'https://www.youtube.com/@coffeesketchpodcast', label: 'YouTube'               },
          { href: 'https://www.instagram.com/coffeesketch_podcast', label: '@coffeesketch_podcast' },
        ].map(({ href, label }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center px-4 py-2 font-mono text-[0.5625rem] tracking-[0.12em] uppercase text-text-secondary border border-rule -mr-px hover:bg-ink hover:text-accent hover:border-ink transition-colors"
          >
            {label} &thinsp;&rarr;
          </a>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>
