---
import BaseLayout from '../../layouts/BaseLayout.astro';
import cv from '../../data/cv.json';
---

<BaseLayout title="CV" description="Curriculum Vitae — Kurt Neiswender, AIA, LEED. Architect, educator, and toolmaker.">

  <!-- Dark header -->
  <header class="bg-ink border-b border-rule-dark animate-fade-up">
    <div class="max-w-7xl mx-auto px-8 py-16 md:py-20">
      <p class="kicker">Curriculum Vitae</p>
      <h1 class="text-text-inv mb-5" style="font-size: clamp(2rem, 3vw + 0.75rem, 4rem);">
        Kurt Neiswender, AIA, LEED
      </h1>
      <p class="text-[0.9375rem] text-[#888] mb-5">
        Principal Architect,
        <a href="https://www.urbancolab.design" target="_blank" rel="noopener"
           class="text-text-inv border-b border-rule-dark hover:border-accent transition-colors">Urban Colab Architecture, L3C</a>
        &middot;
        Assistant Professor of Practice,
        <a href="https://ltu.edu/faculty/neiswender-aia-kurt/" target="_blank" rel="noopener"
           class="text-text-inv border-b border-rule-dark hover:border-accent transition-colors">Lawrence Technological University</a>
      </p>
      <div class="flex gap-4">
        <a href="/about/Curriculum Vitae Practice.pdf" target="_blank" rel="noopener"
           class="font-mono text-[0.5625rem] tracking-[0.12em] uppercase text-accent border-b border-accent pb-px hover:text-text-inv hover:border-text-inv transition-colors">
          Download CV (PDF) &darr;
        </a>
        <a href="/about/Significant Work.pdf" target="_blank" rel="noopener"
           class="font-mono text-[0.5625rem] tracking-[0.12em] uppercase text-accent border-b border-accent pb-px hover:text-text-inv hover:border-text-inv transition-colors">
          Significant Work (PDF) &darr;
        </a>
      </div>
    </div>
  </header>

  <!-- Light content -->
  <section class="bg-bg">
    <div class="max-w-7xl mx-auto px-8 py-12 md:py-14">

      <div class="max-w-3xl">
        {cv.sections.map((section: { title: string; items: { title: string; subtitle?: string; date?: string; description?: string }[] }, i: number) => (
          <div class="mb-12 animate-fade-up" style={`animation-delay: ${0.05 * (i + 1)}s;`}>
            <h2 class="font-heading text-[1.25rem] font-bold uppercase tracking-[0.02em] mb-5 pb-3 border-b-2 border-ink">
              {section.title}
            </h2>
            <div class="space-y-5">
              {section.items.map((item) => (
                <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-1 border-b border-rule pb-4">
                  <div>
                    <p class="font-medium text-[0.9375rem] text-text">{item.title}</p>
                    {item.subtitle && (
                      <p class="text-[0.8125rem] text-text-secondary mt-0.5">{item.subtitle}</p>
                    )}
                    {item.description && (
                      <p class="text-[0.8125rem] text-text-secondary mt-1">{item.description}</p>
                    )}
                  </div>
                  {item.date && (
                    <p class="font-mono text-[0.5625rem] tracking-[0.08em] text-text-secondary self-start mt-0.5">{item.date}</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}

        <div class="pt-4">
          <a href="/about" class="font-mono text-[0.5625rem] tracking-[0.12em] uppercase text-text-secondary border-b border-rule pb-px hover:text-text hover:border-text transition-colors">
            &larr; Back to About
          </a>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
