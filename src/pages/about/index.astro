---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="Kurt Neiswender, AIA, LEED — architect, educator, and toolmaker at Lawrence Technological University. Principal at Urban Colab Architecture.">

  <!-- Dark header -->
  <header class="bg-ink border-b border-rule-dark animate-fade-up">
    <div class="max-w-7xl mx-auto px-8 py-16 md:py-20">
      <p class="kicker">About</p>
      <h1 class="text-text-inv mb-5" style="font-size: clamp(2.5rem, 4vw + 1rem, 5rem);">Kurt Neiswender</h1>
      <p class="text-[1rem] leading-relaxed text-[#888] max-w-xl">
        Registered architect, LEED AP, educator, and toolmaker.
        Principal at Urban Colab Architecture &middot; LTU Assistant Professor of Practice.
      </p>
    </div>
  </header>

  <!-- Light content -->
  <section class="bg-bg">
    <div class="max-w-7xl mx-auto px-8 py-12 md:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-12 lg:gap-16 items-start">

        <!-- Main prose -->
        <div class="prose animate-fade-up">

          <p>
            I&rsquo;m a registered architect, LEED Accredited Professional, and
            <a href="https://ltu.edu/faculty/neiswender-aia-kurt/" target="_blank" rel="noopener">Assistant Professor of Practice</a> at
            <strong>Lawrence Technological University</strong> in the College of
            Architecture and Design. I&rsquo;m also the founder and principal architect at
            <a href="https://www.urbancolab.design" target="_blank" rel="noopener">Urban Colab Architecture, L3C</a>
            in Flint, Michigan.
          </p>

          <p>
            With 20+ years of professional experience&mdash;from firms in Los Angeles
            and Connecticut to my own community-driven practice in Flint&mdash;my work
            sits at the intersection of architectural practice, education, and
            computation. I lead community-driven projects in sustainable housing and
            adaptive reuse, including Gray Street Apartments, Orchard Grove and Manor,
            and the Avalon Village Community Kitchen.
          </p>

          <h2>Teaching</h2>

          <p>
            My teaching centers on <strong>comprehensive design</strong>&mdash;the
            integration of building systems, environmental performance, and design
            intent. I teach HVAC and Water Systems, Acoustics and Illumination, and
            the Comprehensive Design Studio at both undergraduate and graduate levels.
            I&rsquo;m interested in how computational tools can make architects more fluent
            in the technical dimensions of their work without losing the poetry.
          </p>

          <h2>Philosophy</h2>

          <p>
            I believe in <strong>learning in public</strong>. The digital garden on
            this site is where I think out loud&mdash;sharing rough ideas alongside
            polished ones. Architecture is a discipline that benefits from open
            discourse, and the best way to learn is to teach.
          </p>

          <p>
            I also co-host the
            <a href="https://www.coffeesketchpodcast.com" target="_blank" rel="noopener">Coffee Sketch Podcast</a>
            with Jamie Crawley, AIA&mdash;a global design podcast with 190+ episodes
            and listeners in 80+ countries.
          </p>

          <h2>Recognition</h2>

          <ul>
            <li>AIA National Young Architect Award (2017)</li>
            <li>AIA Michigan Young Architect Award (2015)</li>
            <li>AIA Michigan Secretary, Executive Committee (2026&ndash;2029)</li>
            <li>AIA Small Firm Exchange, Board of Directors (2019&ndash;2021)</li>
            <li>AIA Flint Honor Awards for Sustainable Design (2018, 2025)</li>
            <li>Building Design + Construction 40 Under 40 (2018)</li>
            <li>ACSA &ldquo;Timber in the City 6&rdquo; participant</li>
            <li>EDRA57 workshop facilitator</li>
            <li>City of Flint Building Board of Appeals (Mayoral Appointment)</li>
            <li>City of Flint Historic District Commission, Vice Chair (Mayoral Appointment)</li>
          </ul>

          <h2>Education</h2>

          <ul>
            <li>Master of Urban Design with Distinction &mdash; Lawrence Technological University</li>
            <li>Post-Professional NY/Paris Program &mdash; Columbia University GSAPP</li>
            <li>Bachelor of Architecture &mdash; University of Southern California</li>
          </ul>

          <p>
            <a href="/about/cv">View full CV &rarr;</a> &nbsp;&middot;&nbsp;
            <a href="/about/Curriculum Vitae Practice.pdf" target="_blank" rel="noopener">Download CV (PDF)</a> &nbsp;&middot;&nbsp;
            <a href="/about/Significant Work.pdf" target="_blank" rel="noopener">Significant Work (PDF)</a>
          </p>

          <h2>Get in Touch</h2>

          <p>
            The best way to reach me is by email at
            <a href="mailto:info@urbancolab.design">info@urbancolab.design</a>.
          </p>

        </div>

        <!-- Sidebar -->
        <aside class="lg:sticky lg:top-24 animate-fade-up" style="animation-delay: 0.1s;">
          <div class="border border-rule p-5 mb-6">
            <p class="kicker">Quick Facts</p>
            <dl class="space-y-3 text-[0.8125rem]">
              {[
                { dt: 'Role',     dd: 'Assistant Professor of Practice, LTU'                   },
                { dt: 'Practice', dd: 'Urban Colab Architecture, L3C', href: 'https://www.urbancolab.design' },
                { dt: 'License',  dd: 'Registered Architect, AIA, LEED AP'                     },
                { dt: 'Location', dd: 'Flint, Michigan'                                        },
                { dt: 'Contact',  dd: 'info@urbancolab.design', href: 'mailto:info@urbancolab.design' },
              ].map(({ dt, dd, href }) => (
                <div>
                  <dt class="font-mono text-[0.5rem] tracking-[0.12em] uppercase text-text-secondary mb-0.5">{dt}</dt>
                  <dd class="text-text font-medium">
                    {href ? (
                      <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener"
                         class="hover:text-accent transition-colors">{dd}</a>
                    ) : dd}
                  </dd>
                </div>
              ))}
            </dl>
          </div>

          <ul class="space-y-2">
            {[
              { href: '/about/cv',                             label: 'Full CV',               ext: false },
              { href: 'https://www.urbancolab.design',         label: 'Urban Colab Architecture', ext: true },
              { href: 'https://www.coffeesketchpodcast.com',   label: 'Coffee Sketch Podcast', ext: true },
              { href: 'https://ltu.edu/faculty/neiswender-aia-kurt/', label: 'LTU Faculty Page', ext: true },
            ].map(({ href, label, ext }) => (
              <li>
                <a
                  href={href}
                  target={ext ? '_blank' : undefined}
                  rel={ext ? 'noopener' : undefined}
                  class="font-mono text-[0.5625rem] tracking-[0.12em] uppercase text-text-secondary border-b border-rule pb-px hover:text-text hover:border-text transition-colors"
                >
                  {label} &thinsp;&rarr;
                </a>
              </li>
            ))}
          </ul>
        </aside>

      </div>
    </div>
  </section>

</BaseLayout>
