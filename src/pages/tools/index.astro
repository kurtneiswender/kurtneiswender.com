---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';

const tools = [
  {
    title: 'HVAC Calculator',
    description: 'Comprehensive energy modeling and HVAC load calculations. Supports multiple building types with space-by-space analysis, EUI reduction strategies, and exportable reports.',
    href: '/tools/hvac-calculator',
    status: 'live' as const,
    icon: '🌡️',
  },
  {
    title: 'EchoTrace',
    description: 'Acoustic simulation and visualization for room design. Model reverberation time, speech intelligibility, and sound distribution in real-time.',
    href: '/tools/echotrace',
    status: 'live' as const,
    icon: '🔊',
  },
  {
    title: 'Timber Designer',
    description: 'Parametric mass timber building designer with real-time 3D visualization. Configure structural bays, floor counts, and CLT/glulam assemblies.',
    href: '/tools/timber-designer',
    status: 'beta' as const,
    icon: '🪵',
  },
  {
    title: 'Pattern Explorer',
    description: "An interactive map of Christopher Alexander's 253 architectural patterns. Navigate the network, compose isometric spatial diagrams, and annotate field observations with AI pattern matching.",
    href: '/tools/pattern-explorer',
    status: 'beta' as const,
    icon: '◉',
  },
  {
    title: 'Proposal Writer',
    description: 'AI-assisted lead qualification and proposal generation for architecture firms. Answer 21 questions, get a fit score, and download a customized PDF proposal with value-based fee framing.',
    href: '/tools/proposal-writer',
    status: 'beta' as const,
    icon: '📋',
  },
];
---

<BaseLayout title="Tools" description="Interactive web tools for architects — HVAC calculations, acoustic simulation, and mass timber design.">

  <!-- Dark header -->
  <header class="bg-ink border-b border-rule-dark animate-fade-up">
    <div class="max-w-7xl mx-auto px-8 py-16 md:py-20">
      <p class="kicker">Practice</p>
      <h1 class="text-text-inv mb-5" style="font-size: clamp(2.5rem, 4vw + 1rem, 5rem);">Tools</h1>
      <p class="text-[1rem] leading-relaxed text-[#888] max-w-xl">
        Interactive instruments for architectural practice. Each tool is a
        standalone web application&mdash;free to use, built to learn.
      </p>
    </div>
  </header>

  <!-- Light content -->
  <section class="bg-bg">
    <div class="max-w-7xl mx-auto px-8 py-12 md:py-14">

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-0 mb-12">
        {tools.map((tool) => (
          <ToolCard {...tool} />
        ))}
      </div>

      <!-- About note -->
      <div class="border border-rule p-6 md:p-8">
        <p class="kicker">About these tools</p>
        <p class="text-[0.875rem] text-text-secondary leading-relaxed max-w-2xl">
          These tools are built with React, TypeScript, and Three.js. They run
          entirely in your browser. Each started as a teaching exercise or
          professional need and evolved into something others might find useful.
          Source code is available on{' '}
          <a href="https://github.com/kurtneiswender" target="_blank" rel="noopener"
             class="text-text border-b border-rule hover:border-accent hover:text-accent transition-colors">
            GitHub
          </a>.
        </p>
      </div>

    </div>
  </section>

</BaseLayout>
