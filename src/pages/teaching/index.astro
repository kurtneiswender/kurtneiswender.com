---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Teaching" description="Architecture courses at Lawrence Technological University — Comprehensive Design Studio and AI-Enabled Toolmaking workshops.">

  <!-- Dark header -->
  <header class="bg-ink border-b border-rule-dark animate-fade-up">
    <div class="max-w-7xl mx-auto px-8 py-16 md:py-20">
      <p class="kicker">LTU · EDRA</p>
      <h1 class="text-text-inv mb-5" style="font-size: clamp(2.5rem, 4vw + 1rem, 5rem);">Teaching</h1>
      <p class="text-[1rem] leading-relaxed text-[#888] max-w-xl">
        Architecture education at LTU&mdash;integrating building performance,
        computation, and design thinking into studio practice.
      </p>
    </div>
  </header>

  <!-- Light content -->
  <section class="bg-bg">
    <div class="max-w-7xl mx-auto px-8 py-12 md:py-14">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-0">

        <!-- Comp Design -->
        <a href="/teaching/comp-design"
           class="group block p-8 md:p-10 border border-rule bg-bg relative overflow-hidden transition-colors hover:bg-surface">
          <div class="absolute top-0 left-0 right-0 h-[3px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left" aria-hidden="true"></div>
          <p class="kicker">Studio</p>
          <h2 class="font-heading text-[1.75rem] font-bold uppercase mb-4 transition-colors">
            Comprehensive Design
          </h2>
          <p class="text-[0.875rem] text-text-secondary leading-relaxed mb-6">
            Capstone design studio at LTU integrating structural, environmental,
            and building systems into a unified architectural proposition.
            ACSA &ldquo;Timber in the City 6&rdquo; competition entry.
          </p>
          <span class="font-mono text-[0.5625rem] tracking-[0.12em] uppercase text-text-secondary group-hover:text-text transition-colors">
            View course &thinsp;&rarr;
          </span>
        </a>

        <!-- EDRA57 -->
        <a href="/teaching/edra57"
           class="group block p-8 md:p-10 border border-rule -ml-px bg-bg relative overflow-hidden transition-colors hover:bg-surface">
          <div class="absolute top-0 left-0 right-0 h-[3px] bg-accent scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left" aria-hidden="true"></div>
          <p class="kicker">Workshop</p>
          <h2 class="font-heading text-[1.75rem] font-bold uppercase mb-4 transition-colors">
            EDRA57 Workshop
          </h2>
          <p class="text-[0.875rem] text-text-secondary leading-relaxed mb-6">
            AI-Enabled Toolmaking for Architects&mdash;a hands-on workshop
            exploring how generative AI can augment architectural computation
            and design workflows.
          </p>
          <span class="font-mono text-[0.5625rem] tracking-[0.12em] uppercase text-text-secondary group-hover:text-text transition-colors">
            View workshop &thinsp;&rarr;
          </span>
        </a>

      </div>
    </div>
  </section>

</BaseLayout>
