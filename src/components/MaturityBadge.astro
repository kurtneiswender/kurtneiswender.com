---
interface Props {
  maturity: 'seed' | 'sprout' | 'evergreen';
}

const { maturity } = Astro.props;

const config = {
  seed:      { label: 'Seed',      cls: 'text-seed      border-seed'      },
  sprout:    { label: 'Sprout',    cls: 'text-sprout    border-sprout'    },
  evergreen: { label: 'Evergreen', cls: 'text-evergreen border-evergreen' },
} as const;

const { label, cls } = config[maturity];
---

<span
  class:list={[
    'inline-block font-mono text-[0.5625rem] tracking-[0.14em] uppercase px-[0.55rem] py-[0.2rem] border',
    cls,
  ]}
>
  {label}
</span>
