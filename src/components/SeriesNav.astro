---
import { getCollection } from 'astro:content';

interface Props {
  series: string;
  currentOrder?: number;
}

const { series, currentOrder } = Astro.props;

const allArticles = await getCollection('garden');
const seriesArticles = allArticles
  .filter((a) => a.data.series === series)
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

const seriesTitle = series
  .split('-')
  .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
  .join(' ');
---

{seriesArticles.length > 1 && (
  <div>
    <p class="font-mono text-[0.5625rem] tracking-[0.18em] uppercase text-text-secondary mb-3 pb-3 border-b border-rule">
      Series: {seriesTitle}
    </p>
    <ol class="list-none space-y-0">
      {seriesArticles.map((article) => {
        const isCurrent = article.data.seriesOrder === currentOrder;
        return (
          <li>
            <a
              href={`/garden/${article.id}`}
              class:list={[
                'flex items-baseline gap-3 py-2.5 px-3 border-b border-rule transition-colors text-[0.8125rem]',
                isCurrent
                  ? 'bg-surface text-text font-semibold border-l-2 border-l-accent'
                  : 'text-text-secondary hover:text-text hover:bg-surface',
              ]}
            >
              <span class="font-mono text-[0.5rem] tracking-[0.08em] text-text-secondary shrink-0 w-5">
                {String(article.data.seriesOrder ?? 0).padStart(2, '0')}
              </span>
              {article.data.title}
            </a>
          </li>
        );
      })}
    </ol>
  </div>
)}
