---
interface Props {
  title: string;
  description: string;
  href: string;
  status: 'live' | 'beta' | 'coming-soon';
  icon?: string;
}

const { title, description, href, status, icon } = Astro.props;

const statusConfig = {
  live:         { label: 'Live',  cls: 'border-ink text-ink'                          },
  beta:         { label: 'Beta',  cls: 'border-text-secondary text-text-secondary'    },
  'coming-soon':{ label: 'Soon',  cls: 'border-rule text-text-secondary'              },
} as const;

const { label, cls } = statusConfig[status];
---

<a
  href={href}
  class="group block p-8 border-[1.5px] border-ink bg-bg relative overflow-hidden"
>
  <!-- Volt fill from bottom on hover -->
  <div
    class="absolute inset-0 bg-accent scale-y-0 group-hover:scale-y-100 origin-bottom transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
    aria-hidden="true"
  ></div>

  <!-- Content sits above the fill -->
  <div class="relative z-10 flex flex-col gap-3 h-full">
    <div class="flex items-start justify-between">
      <span class="font-mono text-[0.5rem] text-text-secondary tracking-[0.1em] group-hover:text-ink transition-colors">
        {icon && <span class="mr-1" aria-hidden="true">{icon}</span>}
      </span>
      <span
        class:list={[
          'font-mono text-[0.625rem] tracking-[0.12em] uppercase px-[0.6rem] py-[0.25rem] border transition-colors duration-200',
          cls,
          'group-hover:border-ink group-hover:text-ink',
        ]}
      >
        {label}
      </span>
    </div>

    <p class="font-heading text-[1.5rem] font-bold uppercase leading-none text-text transition-colors duration-200 group-hover:text-ink">
      {title}
    </p>

    <p class="text-[0.8125rem] leading-relaxed text-text-secondary flex-1 transition-colors duration-200 group-hover:text-ink">
      {description}
    </p>

    <span class="font-mono text-[0.5625rem] tracking-[0.12em] uppercase text-text-secondary self-end transition-colors duration-200 group-hover:text-ink">
      Open tool &rarr;
    </span>
  </div>
</a>
